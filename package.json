{
  "name": "latale-journal",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "releaseKind": "source-baseline",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/policy.test.mjs tests/catalog.test.ts tests/routes.test.ts tests/load-items.test.ts",
    "test:browser": "playwright test",
    "ci": "node scripts/ci.mjs",
    "release:package": "node scripts/release.mjs"
  },
  "dependencies": {
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
